{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://website-spec-factory.dev/schemas/page.schema.json",
  "title": "Website Page",
  "type": "object",
  "required": ["path", "name", "purpose", "sections"],
  "properties": {
    "path": {"type": "string", "pattern": "^/"},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
