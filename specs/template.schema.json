{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://website-spec-factory.dev/schemas/template.schema.json",
  "title": "Reusable Website Template",
  "description": "Abstract reusable patterns extracted from a website reference.",
  "type": "object",
  "required": [
    "template",
    "design",
    "layout",
    "navigation",
    "pages",
    "components",
    "responsive",
    "seo"
  ],
  "properties": {
    "template": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "category",
        "description",
        "source_analysis"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source_analysis": {
          "type": "object",
          "required": ["reference_type", "analyzed_at", "confidence"],
          "properties": {
            "reference_type": {"type": "string", "minLength": 1},
            "analyzed_at": {"type": "string", "format": "date"},
            "confidence": {
              "enum": ["high", "medium", "low", "partial"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "required": ["visual_style", "colors", "typography", "spacing"],
      "properties": {
        "visual_style": {"type": "string", "minLength": 1},
        "colors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/token"}
        },
        "typography": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/token"}
        },
        "spacing": {"$ref": "#/$defs/token"},
        "borders": {"$ref": "#/$defs/token"},
        "shadows": {"$ref": "#/$defs/token"}
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": ["container", "grid", "responsive"],
      "properties": {
        "container": {"type": "string", "minLength": 1},
        "grid": {"type": "string", "minLength": 1},
        "responsive": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": ["variant", "behavior"],
      "properties": {
        "variant": {"type": "string", "minLength": 1},
        "behavior": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "purpose", "sections"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["component", "variant"],
              "properties": {
                "component": {"type": "string", "minLength": 1},
                "variant": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "purpose", "variant", "configuration"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "variant": {"type": "string", "minLength": 1},
          "configuration": {"type": "object"},
          "responsive_behavior": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "description", "basis"],
        "properties": {
          "name": {"type": "string"},
          "category": {"type": "string"},
          "description": {"type": "string"},
          "basis": {"$ref": "#/$defs/basis"}
        },
        "additionalProperties": false
      }
    },
    "responsive": {
      "type": "object",
      "required": ["mobile", "tablet", "desktop"],
      "properties": {
        "mobile": {"type": "string"},
        "tablet": {"type": "string"},
        "desktop": {"type": "string"}
      },
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "required": ["recommended_structure"],
      "properties": {
        "recommended_structure": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision", "basis"],
        "properties": {
          "decision": {"type": "string"},
          "basis": {"$ref": "#/$defs/basis"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "basis": {
      "enum": ["Observed", "Inferred", "Default", "Unknown"]
    },
    "token": {
      "type": "object",
      "required": ["value", "basis"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "basis": {"$ref": "#/$defs/basis"},
        "approximate": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
